{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-mlx.invalid/schemas/candidate_proposal.json",
  "title": "CandidateProposal",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
  "required": ["provider_id", "workload_hash", "config", "candidate_id"],
  "properties": {
    "provider_id": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1},
    "workload_hash": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "pattern": "^[0-9a-f]{64}$"},
    "config": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
      "not": {"required": ["candidate_id"]},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "candidate_id": {
      "allOf": [{"$ref": "#/$defs/no_surrogate_string"}],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Derived from provider_id, workload_hash, and config; never caller-selected."
    }
  },
  "$defs": {
    "no_surrogate_string": {
      "type": "string",
      "not": {"pattern": "[\\uD800-\\uDFFF]"}
    },
    "scalar": {
      "oneOf": [{"$ref": "#/$defs/no_surrogate_string"}, {"type": "integer"}, {"type": "boolean"}]
    }
  }
}
