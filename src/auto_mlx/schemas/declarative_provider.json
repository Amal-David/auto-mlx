{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-mlx.invalid/schemas/declarative_provider.json",
  "title": "DeclarativeProvider",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
  "required": ["provider_id", "configs"],
  "properties": {
    "provider_id": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1},
    "configs": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
        "not": {"required": ["candidate_id"]},
        "additionalProperties": {"$ref": "#/$defs/scalar"}
      }
    }
  },
  "$defs": {
    "no_surrogate_string": {
      "type": "string",
      "not": {"pattern": "[\\uD800-\\uDFFF]"}
    },
    "scalar": {
      "oneOf": [{"$ref": "#/$defs/no_surrogate_string"}, {"type": "integer"}, {"type": "boolean"}]
    }
  },
  "description": "Declarative scalar maps only; candidate IDs are derived by CandidateProposal."
}
