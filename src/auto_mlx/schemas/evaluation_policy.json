{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-mlx.invalid/schemas/evaluation_policy.json",
  "title": "EvaluationPolicy",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
  "required": [
    "warmup_runs", "measurement_runs", "timeout_seconds", "max_output_bytes", "thermal_gate_policy",
    "k_repetitions", "max_measurement_runs", "min_effect_bps", "bootstrap_resamples", "calibration"
  ],
  "properties": {
    "warmup_runs": {"type": "integer", "minimum": 0, "maximum": 100},
    "measurement_runs": {"type": "integer", "minimum": 1, "maximum": 100},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "thermal_gate_policy": {"type": "string", "enum": ["tag", "refuse"]},
    "k_repetitions": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_measurement_runs": {"type": "integer", "minimum": 1, "maximum": 100},
    "min_effect_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "bootstrap_resamples": {"type": "integer", "minimum": 100, "maximum": 1000000},
    "calibration": {"type": "boolean"}
  },
  "$defs": {
    "no_surrogate_string": {
      "type": "string",
      "not": {"pattern": "[\\uD800-\\uDFFF]"}
    }
  }
}
