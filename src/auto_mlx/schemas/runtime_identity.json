{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-mlx.invalid/schemas/runtime_identity.json",
  "title": "RuntimeIdentity",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
  "required": ["runtime", "version", "platform", "machine"],
  "properties": {
    "runtime": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1},
    "version": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1},
    "platform": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1},
    "machine": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1}
  },
  "$defs": {
    "no_surrogate_string": {
      "type": "string",
      "not": {"pattern": "[\\uD800-\\uDFFF]"}
    }
  }
}
