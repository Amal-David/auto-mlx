{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-mlx.invalid/schemas/knob.json",
  "title": "Knob",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {"$ref": "#/$defs/no_surrogate_string"},
  "not": {"properties": {"name": {"const": "candidate_id"}}},
  "required": ["name", "type", "values", "minimum", "maximum"],
  "properties": {
    "name": {"allOf": [{"$ref": "#/$defs/no_surrogate_string"}], "minLength": 1},
    "type": {"enum": ["enum", "integer", "bool"]},
    "values": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/no_surrogate_string"}},
    "minimum": {"type": ["integer", "null"]},
    "maximum": {"type": ["integer", "null"]}
  },
  "description": "Python additionally enforces unique values and minimum <= maximum for integer knobs.",
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "enum"}}},
      "then": {
        "properties": {
          "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "not": {"pattern": "[\\uD800-\\uDFFF]"}}},
          "minimum": {"type": "null"},
          "maximum": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "integer"}}},
      "then": {
        "properties": {
          "values": {"maxItems": 0},
          "minimum": {"type": "integer"},
          "maximum": {"type": "integer"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "bool"}}},
      "then": {
        "properties": {
          "values": {"maxItems": 0},
          "minimum": {"type": "null"},
          "maximum": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "no_surrogate_string": {
      "type": "string",
      "not": {"pattern": "[\\uD800-\\uDFFF]"}
    }
  }
}
