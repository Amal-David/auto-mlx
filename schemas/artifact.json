{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-mlx.invalid/schemas/artifact.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "sha256", "size_bytes"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^/]+(?:/[^/]+)*$",
      "not": {"pattern": "[\\uD800-\\uDFFF]"},
      "description": "A non-empty relative POSIX path with no control characters, drive prefix, empty, dot, or dotdot components."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
